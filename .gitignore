# ============================================================================
# aim.pat is a CLEAN, TEXT-ONLY repository: agent definitions, memory (yaml/md),
# scripts, references and links. Deliverables and big/binary files are NOT stored
# here — they live in Zoho WorkDrive or a dedicated repo (e.g. documentation ->
# BPR1010/bpr1010.misc.docs) and are referenced by PATH. SVG (text) is allowed.
# ============================================================================

# --- Blobs / deliverables — reference by path, never commit ---
# documents
*.pdf
*.docx
*.doc
*.xlsx
*.xls
*.pptx
*.ppt
# archives / packages
*.zip
*.tar
*.tar.gz
*.tgz
*.7z
*.gz
# raster images / media (SVG is text and allowed)
*.png
*.jpg
*.jpeg
*.gif
*.bmp
*.tif
*.tiff
*.ico
*.mp4
*.mov
*.webm
# ML models / native binaries
*.pt
*.onnx
*.pb
*.h5
*.dylib
*.so
*.dll
*.a
*.o
*.bin

# Secrets — never commit real credentials
secrets/secrets.yaml
secrets/shell-exports.sh
nagents/**/01-dendrite/secrets/secrets.yaml

# Memory — private subfolder only
memory/private/

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Claude Code — local overrides only (settings.json is committed)
.claude/settings.local.json
.claude/scheduled_tasks.lock
.claude/*.lock
.mcp.json

# Zoho Mail MCP — per-account credentials
nagents/**/zoho-mail-mcp/node_modules/

# Editor
.vscode/
.idea/
*.swp
*.swo

# Python
__pycache__/
*.py[cod]
*.env
.venv/
venv/

# Node
node_modules/
.npm

# Logs
*.log
logs/

# Rust — build artifacts (regenerable; keep Cargo.lock)
target/

# Runtime / temp
*.tmp
*.bak
.cache/
